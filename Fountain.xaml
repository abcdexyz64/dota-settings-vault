<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="泉印 · Dota 2 配置管家" Width="1280" Height="920" MinWidth="1120" MinHeight="800" WindowStartupLocation="CenterScreen" Background="#10151D" Foreground="#E9E5DD" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#99A5B5"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9E5DD"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#99A5B5"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1A222D"/><Setter Property="BorderBrush" Value="#2D3744"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#303C4C"/><Setter Property="Foreground" Value="#F3EEE5"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B74C3E"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111821"/><Setter Property="Foreground" Value="#E9E5DD"/><Setter Property="BorderBrush" Value="#3A485A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#E9E5DD"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#17212D"/><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C6CFDA"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A6B2C1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="20,11" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#C79B5E"/><Setter Property="Foreground" Value="#F2D5A4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#141C26"/><Setter Property="Foreground" Value="#DFE5EB"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#19222D"/><Setter Property="AlternatingRowBackground" Value="#1C2734"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="34"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#293545"/><Setter Property="Foreground" Value="#A8B6C7"/><Setter Property="Padding" Value="10,9"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#654238"/><Setter Property="Foreground" Value="#FFF2DC"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#151C25" BorderBrush="#2B3440" BorderThickness="0,0,1,0"><DockPanel Margin="22">
   <StackPanel DockPanel.Dock="Bottom"><Button x:Name="ManualButton" Content="使用说明书  ↗" Margin="0,0,0,14"/><TextBlock Text="本地保存 · 自有云端 · 可回滚" FontSize="11" Foreground="#8492A4"/><TextBlock Text="FOUNTAIN SEAL / v2.0" FontSize="10" Foreground="#65758A" Margin="0,7,0,0"/></StackPanel>
   <StackPanel><Image x:Name="BrandImage" Width="100" Height="100" HorizontalAlignment="Left" Margin="0,12,0,10"/><TextBlock Text="泉 印" FontSize="32" FontWeight="Bold"/><TextBlock Text="DOTA 2 配置管家" Foreground="#CBA56B" Margin="0,6,0,32"/><TextBlock Text="选择操作级别" Style="{StaticResource Caption}"/>
    <Button x:Name="SimpleMode" HorizontalContentAlignment="Left" Margin="0,0,0,10" Padding="12,15"><StackPanel><TextBlock Text="01   简单操作" FontWeight="SemiBold"/><TextBlock Text="打开 · 保存 · 导入 · 替换" FontSize="11" Foreground="#B9C3D0" Margin="0,5,0,0"/></StackPanel></Button>
    <Button x:Name="CloudMode" Margin="0,0,0,10" Padding="12,15"><StackPanel><TextBlock Text="02   进阶" FontWeight="SemiBold"/><TextBlock Text="简单操作 + GitHub 备份" FontSize="11" Foreground="#B9C3D0" Margin="0,5,0,0"/></StackPanel></Button>
    <Button x:Name="AdvancedMode" Margin="0,0,0,20" Padding="12,15"><StackPanel><TextBlock Text="03   高级功能" FontWeight="SemiBold"/><TextBlock Text="进阶功能 + 文件与参数" FontSize="11" Foreground="#B9C3D0" Margin="0,5,0,0"/></StackPanel></Button>
    <Border Background="#202A36" CornerRadius="8" Padding="12"><TextBlock x:Name="ModeHint" Text="从简单操作开始。所有方案保存在同一个本地库，切换级别无需重复操作。" FontSize="12" Foreground="#9EADBF" LineHeight="21"/></Border>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,20,28,18"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="PageTitle" Text="把熟悉的操作，留在自己手里。" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="键位、小地图、镜头与个人偏好，一起保存。" Foreground="#93A2B5" Margin="0,8,0,0"/></StackPanel>
   <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="目标账号" VerticalAlignment="Center" Foreground="#A5B1C1"/><ComboBox x:Name="Accounts" Grid.Column="1"/><TextBlock x:Name="AccountHint" Grid.Column="2" Text="选择 Steam 账号目录；不会自动覆盖任何设置。" VerticalAlignment="Center" Margin="16,0" FontSize="12" Foreground="#93A2B5"/><Button x:Name="PathsButton" Grid.Column="3" Content="路径设置" Margin="0"/></Grid></Border>
   <TabControl x:Name="Pages" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,14,0,0">
    <TabItem x:Name="LocalTab" Header="本地方案"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="保存一份自己的设置" Style="{StaticResource Heading}"/><TextBlock Text="默认存到程序内的备份文件夹。每次保存都保留独立版本。" Style="{StaticResource Caption}"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="ProfileName" Text="我的设置" Margin="0,0,10,0"/><Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource Primary}" Content="保存并打开" Margin="0"/></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBox x:Name="ExportPath" FontSize="11"/><Button x:Name="BrowseExport" Grid.Column="1" Content="选择" Margin="10,0,0,0"/></Grid><TextBlock x:Name="ScopeHint" Text="默认范围：键位、界面选项、编组和自定义启动配置；不含画质。" FontSize="11" Foreground="#9AA8B8" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="打开设置目录" Style="{StaticResource Heading}"/><TextBlock Text="查看原文件，不会修改内容。" Style="{StaticResource Caption}"/><WrapPanel><Button x:Name="OpenLocal" Content="本地 cfg" Margin="0,0,8,8"/><Button x:Name="OpenRemote" Content="云端 cfg" Margin="0,0,0,8"/><Button x:Name="OpenAccount" Content="账号 570"/><Button x:Name="OpenGame" Content="游戏 cfg" Margin="0"/></WrapPanel></StackPanel></Border>
     </Grid>
     <Border Grid.Row="1" x:Name="DropZone" AllowDrop="True" Style="{StaticResource Card}" BorderBrush="#806447" Background="#211F20"><StackPanel><TextBlock Text="↓  拖入备份、配置文件或文件夹" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="也可以指定路径。导入先放进方案库，再由你选择是否替换。" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="82"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBox x:Name="ImportPath" AllowDrop="False"/><Button x:Name="BrowseImport" Grid.Column="1" Content="文件" Margin="8,0,0,0"/><Button x:Name="BrowseFolder" Grid.Column="2" Content="文件夹" Margin="8,0,0,0"/><Button x:Name="ImportButton" Grid.Column="3" Content="导入" Margin="8,0,0,0"/></Grid></StackPanel></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Padding="12,5" Margin="0"/><TextBlock Text="我的方案库" Style="{StaticResource Heading}"/></DockPanel><DataGrid Grid.Row="1" x:Name="Profiles" MinHeight="55" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="方案名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="保存时间" Binding="{Binding Time}" Width="165"/><DataGridTextColumn Header="文件" Binding="{Binding Count}" Width="55"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/></DataGrid.Columns></DataGrid><CheckBox Grid.Row="2" x:Name="CloudOff" Content="替换前：已关闭 Dota 2 的 Steam 云同步，并已正常退出 Steam 和游戏。"/><WrapPanel Grid.Row="3"><Button x:Name="ExportSelected" Content="导出到指定位置"/><Button x:Name="DesktopExport" Content="导出所选到桌面"/><Button x:Name="PreviewButton" Content="预览更改"/><Button x:Name="ApplyButton" Content="替换当前设置" Style="{StaticResource Primary}" Margin="0"/></WrapPanel></Grid></Border></Grid></TabItem>
    <TabItem x:Name="CloudTab" Header="GitHub 备份" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="自己的设置，存在自己的 GitHub。" Style="{StaticResource Heading}"/><TextBlock Text="此页与本地操作共用同一个方案库。无需重新保存，也不会把个人配置上传到公开源码仓库。" Style="{StaticResource Caption}"/><Button x:Name="LoginButton" Content="登录 / 切换自己的 GitHub" HorizontalAlignment="Left"/><TextBlock Text="私有备份仓库（用户名/仓库名）" Margin="0,24,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBox x:Name="Repository"/><Button x:Name="CreateRepoButton" Grid.Column="1" Content="新建私有仓库" Margin="12,0,0,0"/></Grid><TextBlock Text="选择本地方案" Margin="0,20,0,8"/><ComboBox x:Name="CloudProfiles" DisplayMemberPath="Label"/><WrapPanel Margin="0,20,0,0"><Button x:Name="UploadButton" Content="上传所选方案" Style="{StaticResource Primary}"/><Button x:Name="DownloadButton" Content="下载云端方案"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="三步带走你的习惯" Style="{StaticResource Heading}"/><TextBlock Text="01  在“本地方案”保存或导入自己的设置。&#10;&#10;02  登录 GitHub，上传到自己的私有仓库。&#10;&#10;03  换电脑后下载，回到“本地方案”预览并替换。" Foreground="#AEBACA" LineHeight="24"/><TextBlock Text="账号授权由 GitHub CLI 管理；泉印不保存登录令牌。首次使用需安装 GitHub CLI。" Style="{StaticResource Caption}" Margin="0,24,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="InspectTab" Header="文件与参数" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>
     <StackPanel><DockPanel><Button x:Name="ScanFiles" Content="刷新文件目录" DockPanel.Dock="Right" Margin="0"/><TextBlock Text="看懂配置，再决定保存什么。" Style="{StaticResource Heading}"/></DockPanel><TextBlock Text="上表选择文件，下表查看内部条目。参数只读；未知含义和未解析原文会明确标注。" Style="{StaticResource Caption}"/><CheckBox x:Name="CustomScope" Content="启用自选保存范围（未启用时使用默认范围；离开高级级别会恢复默认）"/></StackPanel>
     <DataGrid x:Name="Files" Grid.Row="1"><DataGrid.Columns><DataGridTemplateColumn Header="保存" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selectable}" HorizontalAlignment="Center" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="位置 / 文件" Binding="{Binding Label}" Width="320" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70" IsReadOnly="True"/><DataGridTextColumn Header="文件用途" Binding="{Binding Description}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
     <Grid Grid.Row="2" Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ParameterCount" Text="选择文件查看参数" VerticalAlignment="Center" Foreground="#CCAD7A"/><TextBox x:Name="ParameterSearch" Grid.Column="1" ToolTip="搜索参数、值、分组或用途"/></Grid>
     <DataGrid x:Name="Parameters" Grid.Row="3" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="参数 / 按键" Binding="{Binding Key}" Width="235"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="150"/><DataGridTextColumn Header="用途说明" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="说明依据" Binding="{Binding Confidence}" Width="95"/></DataGrid.Columns></DataGrid>
     <TextBox x:Name="ParameterDetail" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Text="选择条目可查看完整值、分组路径和原文件行号。"/>
    </Grid></TabItem>
   </TabControl>
   <TextBlock x:Name="Status" Grid.Row="3" Text="就绪 · 默认使用简单操作，备份保存在程序自己的文件夹内。" FontSize="12" Foreground="#9DAEBF" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
